{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state/schema/review_todos.schema.json",
  "title": "Mailing List Review TODOs",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "items"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "issue_number",
          "message_id",
          "author",
          "category",
          "summary",
          "action_required",
          "status",
          "owner_stage",
          "created_at"
        ],
        "properties": {
          "gap_id": { "type": "string" },
          "issue_number": { "type": "integer", "minimum": 1 },
          "message_id": { "type": "string" },
          "thread_url": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
          },
          "author": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["blocking", "design", "testing", "style", "question", "follow-up"]
          },
          "summary": { "type": "string" },
          "action_required": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "resolved", "wontfix"]
          },
          "owner_stage": {
            "type": "string",
            "enum": ["planner", "implementer", "verifier", "publisher", "human"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
